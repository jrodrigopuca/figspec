{
  "name": "figspec",
  "version": "0.1.0",
  "description": "Exporta un componente de Figma con un plugin y lo convierte en component.json, CSS Modules y componentes React (TypeScript).",
  "bin": {
    "figspec": "bin/figspec.js"
  },
  "scripts": {
    "start": "node bin/figspec.js view",
    "extract": "node bin/figspec.js build",
    "viewer": "node src/viewer.js --open",
    "react": "node bin/figspec.js react",
    "playground": "npm --prefix figma-playground run dev",
    "test": "node --test test/"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "figma",
    "css-modules",
    "design-tokens",
    "react",
    "design-to-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrodrigopuca/figspec.git"
  }
}
