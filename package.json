{
  "name": "figspec",
  "version": "0.1.0",
  "description": "Exporta un componente de Figma con un plugin y lo convierte en component.json, CSS Modules y componentes React (TypeScript).",
  "bin": {
    "figspec": "bin/figspec.mjs"
  },
  "scripts": {
    "figspec": "node bin/figspec.mjs",
    "playground": "npm --prefix figma-playground run dev",
    "test": "node --test test/"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "figma",
    "css-modules",
    "design-tokens",
    "react",
    "design-to-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrodrigopuca/figspec.git"
  },
  "dependencies": {
    "@runa-cmd/core": "^1.0.0",
    "zod": "^4.6.7"
  }
}
