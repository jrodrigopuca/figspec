{
  "name": "figspec-playground",
  "private": true,
  "type": "module",
  "description": "Proyecto Vite + React + TypeScript que recibe los componentes de npm run react",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && vite build --outDir node_modules/.figspec-check --emptyOutDir --logLevel warn",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
