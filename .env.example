# Copia este archivo como .env si quieres fijar valores por defecto.
# Los parámetros de la línea de comandos tienen prioridad sobre estas variables.

# Paquete exportado con el plugin de Figma (plugin/)
# FIGMA_FROM=figspec-menu.json

# FIGMA_OUT_DIR=figma-out    # por defecto: figma-<componente>/
# FIGMA_ASSETS=true          # false: no escribe íconos ni imágenes
# FIGMA_PNG=true             # false: no escribe preview.png
# FIGMA_SHALLOW=false        # true: no describe subcomponentes
# FIGMA_CSS=true             # false: solo component.json
