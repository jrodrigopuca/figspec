# Copia este archivo como .env si quieres fijar valores por defecto.
# Los parámetros de la línea de comandos tienen prioridad sobre estas variables.

# Con npm (ver README): npm start genera la salida y el visualizador y lo abre;
# npm run extract solo genera; npm run viewer vuelve a generar y abrir el visualizador.

# Paquete exportado con el plugin de Figma (plugin/). Acepta ~; si el navegador guardó copias
# ("figspec-menu (1).json"), se usa la más reciente.
# FIGMA_FROM=~/Downloads/figspec-menu.json

# FIGMA_NAME=SideMenu        # nombre del componente en código (si en Figma es "Frame 1")
# FIGMA_OUT_DIR=figma-out    # por defecto: figma-<componente>/
# FIGMA_ASSETS=true          # false: no escribe íconos ni imágenes
# FIGMA_PNG=true             # false: no escribe preview.png
# FIGMA_SHALLOW=false        # true: no describe subcomponentes
# FIGMA_CSS=true             # false: solo component.json
# FIGMA_REACT=true           # genera además componentes React (TypeScript)
# FIGMA_VIEWER=true          # genera además viewer.html (visualizador)
# FIGMA_DECISIONS=~/Downloads/figspec-menu.decisions.json  # por defecto: el que esté junto al paquete
# FIGMA_EXTRACT_REPEATED=true  # extrae los ítems repetidos a un subcomponente con props y estados
