# Copia este archivo como .env y completa los valores.
# Los parámetros de la línea de comandos tienen prioridad sobre estas variables.

# Obligatoria. Figma → Settings → Security → Personal access tokens (scope "File content: read").
FIGMA_TOKEN=figd_xxx

# Link al componente: clic derecho → Copy/Paste as → Copy link to selection.
FIGMA_LINK=https://www.figma.com/design/<KEY>/<Nombre>?node-id=1-2

# Opcionales
# FIGMA_OUT_DIR=figma-out    # por defecto: figma-<componente>/
# FIGMA_ASSETS=true          # descarga íconos (SVG) e imágenes
# FIGMA_PNG=true             # descarga preview.png
# FIGMA_SHALLOW=false        # true: no describe subcomponentes
# FIGMA_CSS=true             # false: solo component.json
# FIGMA_MAX_WAIT=60          # segundos máximos de espera al reintentar tras un 429 (0 = sin reintentos)
# FIGMA_OFFLINE=true         # modo de pruebas: solo usa la caché, nunca la red
# FIGMA_CACHE_DIR=.figspec-cache
