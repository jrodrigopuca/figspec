# Configuración local
.env
.env.*
!.env.example

# Carpetas de trabajo (figma-inbox, figma-work, figma-decisions) y salidas por defecto
# (figma-<componente>/): su contenido es privado (diseños y nombres). Solo se versiona el README
# de cada una, para que las carpetas existan al clonar.
figma-*/*
!figma-*/README.md

# figma-playground es un proyecto (se versiona), salvo los componentes entregados y su build
!figma-playground/*
figma-playground/src/components/*
!figma-playground/src/components/README.md
figma-playground/dist/

# Paquetes exportados con el plugin (pueden incluir diseños privados)
figspec-*.json

node_modules/
.DS_Store
